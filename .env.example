# STITCH - AI Career Intelligence SaaS Environment Configuration

# Application Settings
PROJECT_NAME="STITCH - AI Career Intelligence"
PORT=8000
SECRET_KEY="stitch-production-super-secret-jwt-key-change-this"

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="sqlite:///./stitch.db"
# Example PostgreSQL URL: "postgresql://postgres:password@localhost:5432/stitch_db"

# Redis Cache & Session Configuration
REDIS_URL="redis://localhost:6379/0"

# AI Credentials (Optional - system automatically uses DevelopmentAIProvider fallback if missing)
AI_API_KEY=""
AI_PROVIDER="development" # Options: "development", "openai"
